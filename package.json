{
  "name": "rsbuild-vue-starter",
  "version": "1.6.1",
  "private": true,
  "description": "Vue3 TypeScript Starter project for Rstack.",
  "homepage": "https://github.com/logue/rsbuild-vue-starter",
  "bugs": {
    "url": "https://github.com/logue/rsbuild-vue-starter/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/rsbuild-vue-starter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "rs dev --open",
    "lint": "run-s lint:oxlint lint:oxfmt",
    "lint:oxlint": "oxlint --fix",
    "lint:oxfmt": "oxfmt",
    "analyze": "RSDOCTOR=true rs build",
    "test": "rs test",
    "test:watch": "rs test --watch",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "rs build preview",
    "clean": "rimraf dist",
    "clean:hard": "rimraf .rstack/cache .rstack/.rsdoctor demo dist docs node_modules/.tmp node_modules/.cache",
    "build-only": "rs build",
    "type-check": "vize check --tsconfig tsconfig.rsbuild.json",
    "skills:update": "npx skills update",
    "prepare": "rs hooks && (npx --no-install skills --version >/dev/null 2>&1 && npx skills experimental_install --yes || echo '\\033[1;33m⚠️  [Warning] skills command not found. Skipped auto-installation of agent skills.\\033[0m')"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@rsbuild/plugin-type-check": "^1.6.1",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rsdoctor/cli": "^2.0.0",
    "@rsdoctor/mcp-server": "^0.1.5",
    "@rsdoctor/rspack-plugin": "^1.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.6.5",
    "@vue-devtools-rstack/rsbuild": "^0.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^21.0.3",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rimraf": "^6.1.3",
    "rstack": "^0.8.4",
    "typescript": "^7.0.2",
    "vize": "^0.457.0"
  },
  "packageManager": "pnpm@12.11.2",
  "stackblitz": {
    "startCommand": "pnpm run test:unit"
  }
}
