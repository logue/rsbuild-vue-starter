{
  "name": "rsbuild-vue-starter",
  "version": "1.6.0",
  "private": true,
  "description": "Vue3 TypeScript Starter project for Rstack.",
  "homepage": "https://github.com/logue/rsbuild-vue-starter",
  "bugs": {
    "url": "https://github.com/logue/rsbuild-vue-starter/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/rsbuild-vue-starter.git"
  },
  "type": "module",
  "scripts": {
    "dev": "rs dev --open",
    "lint": "run-s lint:oxlint lint:oxfmt",
    "lint:oxlint": "oxlint --fix",
    "lint:oxfmt": "oxfmt",
    "analyze": "RSDOCTOR=true rsbuild",
    "test": "rs test",
    "test:watch": "rs test --watch",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "rs build preview",
    "clean": "rimraf dist",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.cache",
    "build-only": "rs build",
    "type-check": "vize check --tsconfig tsconfig.rsbuild.json",
    "skills:update": "npx skills update"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@esctn/vue-tsc-api": "^1.0.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/markdown": "^8.0.3",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rsdoctor/cli": "^1.6.4",
    "@rsdoctor/mcp-server": "^0.1.5",
    "@rsdoctor/rspack-plugin": "^1.6.4",
    "@rstest/adapter-rsbuild": "^0.12.3",
    "@rstest/core": "^0.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.6.4",
    "@vue-devtools-rstack/rsbuild": "^0.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rimraf": "^6.1.3",
    "rstack": "^0.8.1",
    "typescript": "^7.0.2",
    "vize": "^0.435.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "packageManager": "pnpm@12.9.1",
  "stackblitz": {
    "startCommand": "pnpm run test:unit"
  }
}
