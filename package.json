{
  "name": "rsbuild-vue-starter",
  "version": "1.4.4",
  "private": true,
  "description": "Vue3 TypeScript Starter project for Rsbuild.",
  "homepage": "https://github.com/logue/rsbuild-vue-starter",
  "bugs": {
    "url": "https://github.com/logue/rsbuild-vue-starter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/rsbuild-vue-starter.git"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev --open",
    "lint": "run-s lint:*",
    "lint:biome": "biome check --write",
    "lint:rslint": "rslint --fix .",
    "analyze": "RSDOCTOR=true rsbuild",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "inspect": "rsbuild inspect",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "clean": "rimraf dist",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.cache",
    "skills:update": "npx skills update"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@esctn/vue-tsc-api": "^1.0.1",
    "@eslint/markdown": "^8.0.3",
    "@logue/biome-plugins": "^0.0.3",
    "@rsbuild/core": "^2.2.8",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rsdoctor/cli": "^1.6.4",
    "@rsdoctor/rspack-plugin": "^1.6.4",
    "@rslint/core": "^0.9.3",
    "@rstest/adapter-rsbuild": "^0.12.0",
    "@rstest/core": "^0.12.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.6.2",
    "@vue-devtools-rstack/rsbuild": "^0.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.5.1",
  "stackblitz": {
    "startCommand": "pnpm run test:unit"
  }
}
