{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    // AI agents skill docs.
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.cursor/**",
    "**/.windsurf/**",
    // Build intermediate artifacts.
    "**/.cache/**",
    "**/.data/**",
    "**/.mf/**",
    "**/.nitro/**",
    "**/.nuxt/**",
    "**/.pnpm/**",
    "**/.rstack/**",
    // Test coverage reports.
    "**/coverage/**",
    "**/e2e/**",
    "**/playwright-report/**",
    "**/reports/**",
    "**/test-results/**",
    // Build artifacts.
    "**/demo/**",
    "**/dist/**",
    "**/docs/**",
    "**/storybook-static/**",
    "**/target/**",
    // Node modules
    "**/node_modules/**"
  ],
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "none",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "sortPackageJson": true,
  "sortImports": {
    "newlinesBetween": true,
    "internalPattern": ["@/"],
    "customGroups": [
      {
        "groupName": "framework",
        "elementNamePattern": [
          "vue",
          "vue-router",
          "vue-i18n",
          "pinia",
          "pinia-*",
          "@vue/**",
          "vite",
          "vitest",
          "vitest/**",
          "@vitejs/**"
        ]
      }
    ],
    "groups": [
      "side_effect_style",
      "builtin",
      "framework",
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "type",
      "unknown"
    ]
  }
}
